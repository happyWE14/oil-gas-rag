# Backend environment variables (Spring Boot)
# Copy to `.env` and fill in secrets before running locally.

# --- Core runtime ---
SPRING_PROFILES_ACTIVE=
SERVER_PORT=8080

# --- Postgres ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/paper_collector
SPRING_DATASOURCE_USERNAME=paper_user
SPRING_DATASOURCE_PASSWORD=

# --- Redis ---
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# --- S3 / RustFS / MinIO via x-file-storage ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_DOMAIN=http://127.0.0.1:9000/paper-pdf/
S3_BUCKET=paper-pdf
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=server

# --- Spring AI (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=deepseek-reasoner
OPENAI_CHAT_TEMPERATURE=0.7
OPENAI_CHAT_MAX_TOKENS=4096

OPENAI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIMENSION=2048
EMBEDDING_MODEL_ID=TEXT_EMBEDDING_V4
EMBEDDING_CHUNK_SIZE=400
EMBEDDING_CHUNK_OVERLAP=80
EMBEDDING_BATCH_SIZE=8

# --- Optional generic document RAG endpoint ---
RAG_CUSTOM_ENABLED=false
RAG_CUSTOM_TOP_K=8
RAG_CUSTOM_MAX_CONTEXT_CHARS=12000
# Keep this value on one line when using a .env file.
RAG_CUSTOM_SYSTEM_PROMPT=Answer only from the supplied evidence, cite sources with [ChunkId-<id>], and state when evidence is insufficient.

# --- OCR / Transform ---
TRANSFORM_PROVIDER=PADDLE_OCR
PADDLEOCR_API_URL=http://localhost:8000/layout-parsing
PADDLE_OCR_TOKEN=

DEEPSEEK_OCR_BASE_URL=http://127.0.0.1:8000/v1
DEEPSEEK_OCR_API_URL=http://127.0.0.1:8000/v1/chat/completions
DEEPSEEK_API_KEY=

# --- Download accelerator (optional) ---
DOWNLOAD_ACCELERATOR_ENABLED=false
DOWNLOAD_ACCELERATOR_FALLBACK_ON_FAILURE=true
DOWNLOAD_ACCELERATOR_BASE_URL=https://doget-api.oopscloud.xyz/api
DOWNLOAD_ACCELERATOR_DOWNLOAD_URL_TEMPLATE=https://doget-api.oopscloud.xyz/api/download?token=%s

# --- External search providers (optional overrides) ---
CORE_API_BASE_URL=https://api.core.ac.uk/v3
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
ARXIV_API_BASE_URL=https://export.arxiv.org/api
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=

# --- Forest client override (rare; defaults derive from OPENAI_BASE_URL) ---
OPENAI_FOREST_BASE_URL=

# --- Local file serving / CORS ---
PAPER_STORAGE_PATH=./data/papers
PAPER_STORAGE_ROOT=./data
FILE_PUBLIC_BASE_URL=http://localhost:8080/api/file
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
LOCAL_FILE_OPEN_FOLDER_ENABLED=false
